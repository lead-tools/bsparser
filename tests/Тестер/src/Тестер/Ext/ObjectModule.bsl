
Перем Парсер;

Процедура Пуск(ПарсерВстроенногоЯзыка) Экспорт

	Парсер = ПарсерВстроенногоЯзыка;
	Парсер.СтрогийРежим = Истина;

	 //#Область Разбирается

	Если Не Разбирается("Var x; x = x + 1") Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Разбирается("Var x; x = +x + -1") Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Разбирается("Var x; y = ?(x, 1, 2).y(1)") Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Разбирается("Var x; y = x[0]") Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Разбирается("Var x; y = x[0].z()") Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Разбирается("Var x; y = x[0].z[1].q.q()") Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Разбирается("Var x; x.y = x") Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Разбирается("Асинх Функция Ф() Возврат Ждать Ф(); КонецФункции") Тогда
		ВызватьИсключение "Тест провален: Асинх функция";
	КонецЕсли;

	Если Не Разбирается("Async Procedure P() Await P(); EndProcedure") Тогда
		ВызватьИсключение "Тест провален: Async procedure";
	КонецЕсли;

	Если Не Разбирается("Процедура П() Ждать = 2; Ждать = Ждать + 1; КонецПроцедуры") Тогда
		ВызватьИсключение "Тест провален: Ждать как идентификатор вне Асинх";
	КонецЕсли;

	Если Не Разбирается("Процедура П() Ждать = 2; КонецПроцедуры Асинх Процедура А() Р = Ждать П(); КонецПроцедуры Процедура Б() Ждать = 3; КонецПроцедуры") Тогда
		ВызватьИсключение "Тест провален: Ждать как идентификатор рядом с Асинх методом";
	КонецЕсли;

	Если Не Разбирается("Процедура П() Асинх = 2; Асинх = Асинх + 1; КонецПроцедуры") Тогда
		ВызватьИсключение "Тест провален: Асинх как идентификатор";
	КонецЕсли;

	Если Не Разбирается("Процедура П() КонецПроцедуры А = 3; Асинх = 3;") Тогда
		ВызватьИсключение "Тест провален: Асинх как идентификатор в теле модуля";
	КонецЕсли;

	Если Не Разбирается("Перем Асинх; Перем А, Ждать; Асинх Процедура П() КонецПроцедуры") Тогда
		ВызватьИсключение "Тест провален: Асинх в списке переменных модуля";
	КонецЕсли;

	Если Не Разбирается("Асинх Процедура Ждать() КонецПроцедуры Процедура Б() Ждать(); КонецПроцедуры") Тогда
		ВызватьИсключение "Тест провален: метод с именем Ждать";
	КонецЕсли;

	Если Не Разбирается("Асинх
	|// комментарий
	|Процедура А() Асинх = 1; Р = Ждать А(); КонецПроцедуры") Тогда
		ВызватьИсключение "Тест провален: Асинх и метод на разных строках";
	КонецЕсли;

	Если Не Разбирается("Асинх Процедура А() КонецПроцедуры Асинх Процедура Б() КонецПроцедуры Процедура В() Асинх = 1; КонецПроцедуры") Тогда
		ВызватьИсключение "Тест провален: подряд идущие Асинх методы";
	КонецЕсли;

	Модуль = Парсер.Разобрать("Асинх Функция Ф() Возврат Ждать Ф(); КонецФункции");
	Если Не Модуль.Объявления[0].Сигнатура.Асинх Тогда
		ВызватьИсключение "Тест провален: признак Асинх";
	КонецЕсли;

	 //#КонецОбласти // Разбирается

	 //#Область Падает

	Если Не Падает("x = x + 1", 10, 1, 5) Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Падает("x = y + 1", 10, 1, 5) Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Падает("x[0] = 1 + 1", 10, 1, 1) Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Падает("For Each x In x Do EndDo", 10, 1, 15) Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Падает("For Each In x do EndDo", 1, 1, 10) Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Падает("For x In x do EndDo", 1, 1, 7) Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Падает("For x = 1 In x do EndDo", 1, 1, 11) Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Падает("For x = 1 To 2 EndDo", 1, 1, 16) Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Падает("x = .1", 7, 1, 5) Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Падает("x = 1.x", 1, 1, 7) Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Падает("x = 1 1", 1, 1, 7) Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Падает("x = / 2", 7, 1, 5) Тогда
		ВызватьИсключение "Тест провален";
	КонецЕсли;

	Если Не Падает("Асинх Процедура П() Ждать = 2; КонецПроцедуры", 7, 1, 27) Тогда
		ВызватьИсключение "Тест провален: Ждать внутри Асинх - ключевое слово";
	КонецЕсли;

	Если Не Падает("Процедура П() КонецПроцедуры Асинх = 3;", 22, 1, 36) Тогда
		ВызватьИсключение "Тест провален: Асинх первым в теле модуля";
	КонецЕсли;

	Если Не Падает("Асинх Процедура П() Х = Ждать - 1; КонецПроцедуры", 7, 1, 31) Тогда
		ВызватьИсключение "Тест провален: Ждать - 1";
	КонецЕсли;

	Если Не Падает("Асинх Функция Ф() Х = Ждать Ждать Ф(); КонецФункции", 11, 1, 29) Тогда
		ВызватьИсключение "Тест провален: Ждать Ждать";
	КонецЕсли;

	Если Не Падает("Асинх Перем Х;", 22, 1, 7) Тогда
		ВызватьИсключение "Тест провален: Асинх без метода";
	КонецЕсли;

	 //#КонецОбласти // Падает

	Сообщить("Все тесты прошли!");

КонецПроцедуры

Функция Разбирается(Исходник)

	Попытка
		Парсер.Разобрать(Исходник);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Если Парсер.ТаблицаОшибок().Количество() > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция Падает(Исходник, Код, НомерСтроки, Позиция)

	Попытка
		Парсер.Разобрать(Исходник);
	Исключение

	КонецПопытки;

	Ошибки = Парсер.ТаблицаОшибок();

	Если Ошибки.Количество() <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	Ошибка = Ошибки[0];

	Если Ошибка.Код <> Код
		Или Ошибка.ПозицияНачала <> Позиция
		Или Ошибка.НомерСтрокиНачала <> НомерСтроки Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции
